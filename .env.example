# Copy to .env and fill in.
# SQLite (local):   file:./dev.db
# MySQL:            mysql://USER:PASSWORD@HOST:3306/DBNAME
# PostgreSQL:       postgresql://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL="file:./dev.db"
# Long random string used to sign admin sessions: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
ADMIN_EMAIL="admin@busestransport.com"
ADMIN_PASSWORD=""
UPLOAD_DIR="./storage/uploads"
SITE_URL="https://busestransport.com"
