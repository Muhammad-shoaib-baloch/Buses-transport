APP_NAME="Buses Transport UAE"
APP_ENV=production
# Generate with: php artisan key:generate --show   (the deploy package fills this for you)
APP_KEY=
APP_DEBUG=false
APP_URL=https://busestransport.com
# Google may index the site only on this domain. On a temporary / staging
# domain the pages get noindex automatically — keep this as the real domain.
LIVE_URL=https://busestransport.com

# MySQL database created in cPanel → MySQL Databases
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# First admin account (used once by the installer / seeder)
ADMIN_EMAIL=admin@busestransport.com
ADMIN_PASSWORD=

# Secret for the one-time installer: https://yoursite.com/install?key=THIS_VALUE
SETUP_KEY=

SESSION_DRIVER=file
SESSION_LIFETIME=720
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error
MAIL_MAILER=log
BCRYPT_ROUNDS=12
